DOJO_ENVIRONMENT=development
# Academy time zone: "today", day boundaries in reports and displayed times.
DOJO_TIMEZONE=Asia/Kuwait
DOJO_DB_HOST=127.0.0.1
DOJO_DB_PORT=3306
DOJO_DB_USER=dojo
DOJO_DB_PASSWORD=change-me
DOJO_DB_NAME=dojo
# Where Dojo Manager listens: API and web app on one port (start.sh / pm2 app "dojo").
DOJO_HOST=0.0.0.0
DOJO_PORT=8090
# Sign-in cookies are HTTPS-only unless this is false; set false for plain http://.
DOJO_COOKIE_SECURE=false
DOJO_CORS_ORIGINS=["http://localhost:5173"]
# Member portal: key for hashing sign-in codes (any long random string; keep it secret).
DOJO_PORTAL_SECRET=
# WhatsApp / SMS provider for the portal. "console" logs messages instead of sending them;
# outside production the portal then shows the sign-in code on screen.
DOJO_MESSAGING_BACKEND=console
# KNET / card provider for online renewals. "test" shows Approve / Decline instead of the
# bank's page; online renewal stays off in production until a real provider is set.
DOJO_PAYMENT_GATEWAY=test
# Used once by `python -m app.seed` to create the first owner account.
DOJO_BOOTSTRAP_OWNER_USERNAME=owner
DOJO_BOOTSTRAP_OWNER_PASSWORD=
